<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Essential permissions for privacy overlay functionality -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="com.android.vending.CHECK_LICENSE" />

    <!-- Package visibility queries for Google Play Store package verification (Android 11+) -->
    <queries>
        <package android:name="com.android.vending" />
        <intent>
            <action android:name="com.android.vending.licensing.ILicensingService" />
        </intent>
    </queries>

    <application
        android:name=".PrivacyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AntiPhoneSnatcher"
        tools:targetApi="35">

        <property
            android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
            android:value="System-wide privacy overlay display filter" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_app_name"
            android:theme="@style/Theme.AntiPhoneSnatcher"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Panic Blackout Fullscreen Lock Activity -->
        <activity
            android:name=".ui.PanicLockActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.AntiPhoneSnatcher"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- Privacy Screen Overlay Foreground Service -->
        <service
            android:name=".service.PrivacyOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse" />

        <!-- Quick Settings Tile -->
        <service
            android:name=".service.PrivacyTileService"
            android:exported="true"
            android:icon="@drawable/ic_privacy_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Optional Hardware Shortcut Accessibility Service (Volume key double-press) -->
        <service
            android:name=".service.PrivacyAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Home Screen App Widget: Standard Quick Bar (3x1) -->
        <receiver
            android:name=".widget.PrivacyWidgetProvider"
            android:exported="true"
            android:label="@string/widget_regular_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.antiphonesnatcher.app.ACTION_TOGGLE_PRIVACY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/privacy_widget_info" />
        </receiver>

        <!-- Home Screen App Widget: Compact Quick Badge (1x1) -->
        <receiver
            android:name=".widget.CompactWidgetProvider"
            android:exported="true"
            android:label="@string/widget_compact_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.antiphonesnatcher.app.ACTION_TOGGLE_PRIVACY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/privacy_widget_compact_info" />
        </receiver>

        <!-- Home Screen App Widget: Defense Dashboard (4x2) -->
        <receiver
            android:name=".widget.LargeWidgetProvider"
            android:exported="true"
            android:label="@string/widget_large_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.antiphonesnatcher.app.ACTION_TOGGLE_PRIVACY" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/privacy_widget_large_info" />
        </receiver>

        <!-- Boot Receiver for restoring state if enabled by user -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
